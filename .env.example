# Midnight Network Configuration
# Required: Contract address deployed on Midnight testnet
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=

# Required: Midnight indexer endpoints
NEXT_PUBLIC_MIDNIGHT_INDEXER_HTTP=https://indexer.testnet-02.midnight.network/api/v1/graphql
NEXT_PUBLIC_MIDNIGHT_INDEXER_WS=wss://indexer.testnet-02.midnight.network/api/v1/graphql/ws

# Required: Midnight proof server
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER=https://lace-dev.proof-pub.stg.midnight.tools

# Required: Network identifier (TestNet or MainNet)
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=TestNet

# Optional: Midnight explorer URL for transaction links
NEXT_PUBLIC_MIDNIGHT_EXPLORER_URL=https://explorer.testnet.midnight.network

# Optional: Asset application integration (if bridging to another dApp)
NEXT_PUBLIC_ASSET_APP_URL=
ASSET_APP_ORIGIN=
